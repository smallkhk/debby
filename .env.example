# ── Prism Studio configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. NEVER commit your real .env.

# Your permanent Decart API key. Get it from https://platform.decart.ai
# This stays on the server ONLY. It is never sent to the browser.
DECART_API_KEY=your-decart-api-key-here

# Port the server listens on.
PORT=3000

# Comma-separated list of Decart models this deployment is allowed to use.
# Ephemeral tokens are scoped to exactly these models, so a leaked token
# still can't be used against a model you don't offer.
ALLOWED_MODELS=lucy-2.5,lucy-restyle-2,lucy-vton-3

# TTL (seconds) for the short-lived client token minted for each session.
TOKEN_TTL_SECONDS=300

# ── Abuse protection (protects YOUR spend, since sessions run on your key) ─────
# Max token mints allowed per IP address within the rolling window below.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=3600

# ── Access gate ───────────────────────────────────────────────────────────────
# open  = anyone who loads the site can start a session (rate-limited).
# code  = the visitor must supply a valid access code (see ACCESS_CODES).
#         Use this as the simplest paywall: hand a code to each paying customer.
ACCESS_MODE=open

# Comma-separated access codes accepted when ACCESS_MODE=code.
# e.g. ACCESS_CODES=vip-abc123,team-xyz789
ACCESS_CODES=
