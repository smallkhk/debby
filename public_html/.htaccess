# ── Eclipse Creator Studio — Apache / LiteSpeed config (cPanel) ──────────────

# The Studio is the landing page: visiting the domain drops customers straight
# into the app. Signed-out visitors are bounced to /login.html by the Studio
# itself. The marketing/pricing page is still reachable at /index.html and is
# linked from the login and register screens.
DirectoryIndex studio.html index.html index.php

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
</IfModule>

# ── Never serve the JSON data stores or dotfiles ─────────────────────────────
# data/ has its own .htaccess too; this is a second line of defence in case a
# path bug ever exposes a store from somewhere else in the tree.
<FilesMatch "\.(json|log|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ── Force HTTPS ──────────────────────────────────────────────────────────────
# Browsers block getUserMedia (camera/mic) on plain http, so the Studio simply
# will not work without this. Enable AutoSSL in cPanel first, then uncomment.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── Optional: pick ONE canonical domain ──────────────────────────────────────
# Sessions and device tokens are stored per-domain, so users bouncing between
# two hostnames get logged out. Uncomment and edit to 301 one to the other.
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^(www\.)?example\.com$ [NC]
# RewriteRule ^(.*)$ https://example.online/$1 [R=301,L]

# ── Static asset caching ─────────────────────────────────────────────────────
# CSS and JS are cached for an hour, not a week. Pages link them with a ?v=
# build token that changes on release, so a browser picks up new files at once
# — but only if it also fetched the new HTML. A short TTL is the safety net for
# the common case where some files are uploaded before others: the site
# self-heals within the hour instead of showing a broken mix for seven days.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # HTML must never be cached, or a browser keeps requesting the old ?v= token
  # and the whole scheme stops working.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
